---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src?: ImageMetadata; alt: string; segnaposto: string; nota?: string; larghezze?: number[]; sizes?: string; class?: string }
const { src, alt, segnaposto, nota = 'foto in arrivo', larghezze = [320, 640, 960], sizes = '(max-width: 720px) 100vw, 400px', class: cls = '' } = Astro.props;
---
<div class={`slot ${cls}`}>
  {src ? (
    <Image src={src} alt={alt} widths={larghezze} sizes={sizes} format="webp" quality={78} />
  ) : (
    <div class="vuota" role="img" aria-label={`${alt}: ${nota}`}>
      <b>{segnaposto}</b>
      <small>{nota}</small>
    </div>
  )}
</div>
