---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import FotoSlot from '../components/FotoSlot.astro';
import Voto from '../components/Voto.astro';
import { fotoGane, iniziali, estratto } from '../lib';
import v from '../data/verdetti.json';

const gani = (await getCollection('gani')).sort((a, b) => a.data.nome.localeCompare(b.data.nome, 'it'));
const pubblicate = gani.filter((g) => g.data.stato === 'pubblicata').length;

// Foto di gruppo: src/assets/copertina.jpg (o .png/.webp)
const cop = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/copertina.{jpg,jpeg,png,webp}', { eager: true })
)[0]?.default;
---
<Base titolo="GANI · Wiesn 2026 · Le pagelle" attiva="pagelle">
  <section class="hero">
    <div class="kicker">26–29 settembre 2026 · München</div>
    <h1>I GANI<br />all'<span class="gold">OKTOBERFEST</span></h1>
    <p class="sub">Partiti in 16, tornati in 16. A fine partita si danno i voti.</p>
    <div style="max-width:560px;margin:30px auto 0;border:6px solid var(--schiuma);border-radius:8px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,.55),0 0 0 3px var(--oro);transform:rotate(-1deg)">
      <FotoSlot src={cop} alt="I GANI all'Oktoberfest 2026" segnaposto="GANI" nota="foto di gruppo in arrivo" larghezze={[480, 960, 1400]} sizes="(max-width: 600px) 100vw, 560px" class="cop" />
    </div>
  </section>

  <section class="sec" id="pagelle">
    <h2>Le pagelle</h2>
    <p class="dis">{pubblicate === 0 ? 'In arrivo: ognuno dà il voto al compagno di stanza.' : `${pubblicate} su ${gani.length} pubblicate`}</p>
    <div class="pagelle">
      {gani.map((g) => (
        <a class="card" href={`/pagelle/${g.id}`}>
          <FotoSlot src={fotoGane(g.id)} alt={g.data.nome} segnaposto={iniziali(g.data.nome)} sizes="(max-width: 480px) 50vw, 240px" larghezze={[240, 480]} />
          <div class="info">
            <div class="riga"><h3>{g.data.nome}</h3><Voto voto={g.data.stato === 'pubblicata' ? g.data.voto : undefined} /></div>
            {g.data.stato === 'pubblicata'
              ? <p>{g.data.titolo ?? estratto(g.body)}</p>
              : <p class="attesa">Pagella in arrivo</p>}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="sec">
    <h2>Il tabellino</h2>
    <p class="dis">Verdetti di squadra</p>
    <ul class="tabellino box">
      {v.tabellino.map((r) => <li><b>{r.ruolo}</b><span class={r.chi ? '' : 'tbd'}>{r.chi || 'da assegnare'}</span></li>)}
    </ul>
  </section>

  <section class="sec">
    <h2>Extra-campo</h2>
    <p class="dis">Anche i non convocati prendono il voto</p>
    <div class="extra">
      {v.extracampo.map((e) => (
        <div class="box">
          <div class="riga"><h3>{e.ic} {e.nome}</h3><Voto voto={e.voto || undefined} /></div>
          <p class={e.giudizio ? '' : 'tbd'}>{e.giudizio || 'Giudizio in arrivo'}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <h2>Il verdetto del Toto-Wiesn</h2>
    <p class="dis">I pronostici sigillati prima della partenza, contro il campo</p>
    <div class="toto">
      {v.totowiesn.map((t) => (
        <div class="box">
          <div class="ic">{t.ic}</div>
          <h3>{t.domanda}</h3>
          <div class="col"><span>Pronostico</span>{t.pronostico}</div>
          <div class="col"><span>Com'è andata</span>
            {t.realta ? (t.momento ? <a href={`/diario#${t.momento}`}>{t.realta}</a> : t.realta) : <i class="tbd">da verificare</i>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <h2>I numeri</h2>
    <p class="dis">Previsti contro reali</p>
    <div class="numeri">
      {v.numeri.map((n) => (
        <div class="box">
          <div class="ic">{n.ic}</div>
          <div class="k">{n.voce}</div>
          <div class="vs">
            <div class="prev"><b>{n.previsti ?? '–'}</b><small>previsti</small></div>
            <div><b>{n.reali ?? '?'}</b><small>reali</small></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec" style="text-align:center">
    <h2>Il diario</h2>
    <p class="dis">Quattro giorni, momento per momento</p>
    <a class="btn" href="/diario">Leggi il diario →</a>
  </section>
</Base>
